  "userscriptHeader": {
    "@match": [
      "http*://example.com/",
      "http*://www.example.com/"
    ],
    "@grant": "GM_addStyle"
  },
  "author": "dead1ne",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.33",
    "bun-style-loader": "^0.4.0",
    "rimraf": "^6.0.1",
    "sass": "^1.79.4",
    "type-fest": "^4.26.1",
    "winston": "^3.14.2",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "bun build.ts",
    "build:dev": "bun build.ts --dev",
